@page
@model IndexModel
@* @{
    Layout = null;
    } *@

@* @{
    ViewData["Title"] = "Home page";
    } *@

<div class="form-container">

    <h1>Анкета студента</h1>

    <p class="description">
        Введите свои данные
    </p>

    <form method="post">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label>Имя-фамилия:</label>
            <input type="text" name="Name" placeholder="Введите имя" required>
        </div>

        <div class="form-group">
            <label>Номер телефона:</label>
            <input type="tel" name="Phone" placeholder="+7" required>
        </div>

        <div class="form-group">
            <label>Email:</label>
            <input type="email" name="Email" placeholder="email@example.com" required>
        </div>

        <div class="form-group">
            <label for="cities">Курс:</label>
            <select name="City" id="cities">
                <option value="Сочи">Сочи</option>
                <option value="Краснодар">Краснодар</option>
                <option value="Москва">Москва</option>
                <option value="Санкт-Петербург">Санкт-Петербург</option>
            </select>
        </div>
        
        <div class="form-group">
            <label>Основной язык программирования</label>
            
            <div class="speciality">

                <input type="radio" name="MainLanguage" value="Python" id="py">
                <label for="py">Python</label>

                <br>
                <input type="radio" name="MainLanguage" value="C#" id="cs">
                <label for="cs">C#</label>

                <br>
                <input type="radio" name="MainLanguage" value="Java" id="java">
                <label for="java">Java</label>

                <br>

            </div>
        </div>

        <div class="form-group">
            <label>Формат обучения</label>
            
            <div class="speciality">

                <input type="radio" name="ModeOfStudy" value="Очная" id="och">
                <label for="och">Очная</label>

                <br>
                <input type="radio" name="ModeOfStudy" value="Заочная" id="zaoch">
                <label for="zaoch">Заочная</label>

                <br>
                <input type="radio" name="ModeOfStudy" value="Очно-заочная" id="och-zaoch">
                <label for="och-zaoch">Очно-заочная</label>

                <br>

            </div>
        </div>

        <div class="form-group">
            <label>Специальность:</label>

            <div class="speciality">

                <input type="radio" name="Speciality" value="Программирование" id="dev">
                <label for="dev">Программирование</label>

                <br>

                <input type="radio" name="Speciality" value="Дизайн" id="design">
                <label for="design">Дизайн</label>

                <br>

                <input type="radio" name="Speciality" value="Маркетинг" id="marketing">
                <label for="marketing">Маркетинг</label>

            </div>
        </div>
        <div class="form-group">
            <label for="courses">Курс:</label>
            <select name="Course" id="courses">
                <option value="1 курс">1 курс</option>
                <option value="2 курс">2 курс</option>
                <option value="3 курс">3 курс</option>
                <option value="4 курс">4 курс</option>
            </select>
        </div>
        <div class="form-group">
            <label for="">Дата рождения:</label>
            <input type="date" name="BirthDate" required>
        </div>
        <div class="form-group">
            <label for="">Технологии:</label>
            <div class="speciality">
                <input type="checkbox" name="Technologies" value="HTML/CSS" id="html">
                <label for="html">HTML/CSS</label>
                <br>
                <input type="checkbox" name="Technologies" value="JavaScript" id="js">
                <label for="js">JavaScript</label>
                <br>
                <input type="checkbox" name="Technologies" value="C#" id="csharp">
                <label for="csharp">C#</label>
                <br>
                <input type="checkbox" name="Technologies" value="Python" id="python">
                <label for="python">Python</label>
                <br>
                <input type="checkbox" name="Technologies" value="ASP.NET" id="aspNET">
                <label for="aspNET">ASP.NET</label>
                <br>
                <input type="checkbox" name="Technologies" value="AJAX" id="ajax">
                <label for="ajax">AJAX</label>
            </div>
        </div>

        <div class="form-group">

            <label for="story">О себе:</label>
            <input id="story" name="Story" rows="3" cols="22" required>
        </div>
        <button class="form-button" type="submit">
            Отправить
        </button>
        <button class="clear-button" type="reset">Очистить</button>
    </form>

    <div id="status" class="status"></div>

    <div id="result" class="student-card">
        <div>
            <h2>Анкета отправлена</h2>
            <p>Данные студента:</p>
        </div>
        <div class="student-info">
            <div class="info-item">
                <span>Имя</span>
                <strong id="result-name"></strong>
            </div>
            <div class="info-item">
                <span>Номер телефона</span>
                <strong id="result-phone"></strong>
            </div>
            <div class="info-item">
                <span>Email</span>
                <strong id="result-email"></strong>
            </div>
            <div class="info-item">
                <span>Город</span>
                <strong id="result-city"></strong>
            </div>
            <div class="info-item">
                <span>Основной язык</span>
                <strong id="result-mainLanguage"></strong>
            </div>
            <div class="info-item">
                <span>Формат обучения</span>
                <strong id="result-modeOfStudy"></strong>
            </div>
            <div class="info-item">
                <span>Специальность</span>
                <strong id="result-speciality"></strong>
            </div>
            <div class="info-item">
                <span>Курс</span>
                <strong id="result-course"></strong>
            </div>
            <div class="info-item">
                <span>Дата рождения</span>
                <strong id="result-birthDate"></strong>
            </div>
            <div class="info-item">
                <span>Технологии</span>
                <strong id="result-technologies"></strong>
            </div>
            <div class="info-item">
                <span>О себе</span>
                <strong id="result-story"></strong>
            </div>
        </div>
    </div>

    @if (Model.Message != null)
    {
        <div class="result">
            <h3>Данные анкеты:</h3>

            <p style="white-space: pre-line;">
                @Model.Message
            </p>
        </div>
    }
    @* СПИСОК ВСЕХ СТУДЕНТОВ *@
    <div class="students-section">
        <h2>Список студентов</h2>
        <div id="students-list"></div>
    </div>

</div>

<script>
    const form = document.querySelector("form");
    const button = form.querySelector("button[type='submit']");
    const status = document.querySelector("#status");
    const studentsList = document.querySelector("#students-list");
    
    form.addEventListener("submit", async function (event) {
        event.preventDefault();

        button.textContent = "Отправка..."
        button.disabled = true;

        const formData = new FormData(form);

        try {
            const response = await fetch("", {
                method: "POST",
                body: formData
            });

            if (!response.ok) {
                throw new Error("Ошибка сервера");
            }

            const data = await response.json();
            console.log(data);
            await new Promise(resolve => setTimeout(resolve, 1500));

            document.querySelector("#result-name").textContent = data.name;
            document.querySelector("#result-phone").textContent = data.phone;
            document.querySelector("#result-email").textContent = data.email;
            document.querySelector("#result-city").textContent = data.city;
            document.querySelector("#result-mainLanguage").textContent = data.mainLanguage;
            document.querySelector("#result-modeOfStudy").textContent = data.modeOfStudy;
            document.querySelector("#result-speciality").textContent = data.speciality;
            document.querySelector("#result-course").textContent = data.course;
            document.querySelector("#result-birthDate").textContent = data.birthDate;
            document.querySelector("#result-technologies").textContent = data.technologies;
            document.querySelector("#result-story").textContent = data.story;
            
            document.querySelector("#result").style.display = "block";
            status.textContent = "Анкета успешно отправлена";

            // @* ОБНОВЛЯЕМ СПИСОК СТУДЕНТОВ *@
                await loadStudents();

            // @* ОЧИЩАЕМ ФОРМУ *@
                form.reset();
        } catch (error) {
            console.error(error)
            status.textContent = "Не удалось отправить анкету";
        } finally {
            button.disabled = false;
            button.textContent = "Отправить";
        }
    });

    @* Подгружаем Список студентов *@
    async function loadStudents() {
        try {
            const response = await fetch("?handler=Students");

            if(!response.ok) {
                throw new Error("Ошибка загрузки студентов")
            };

            const students = await response.json()
            @* ОЧИЩАЕМ СТАРЫЙ СПИСОК *@
            studentsList.innerHTML = "";
            
            students.forEach(student => {
                const card = document.createElement("div");
                card.className = "student-card";
                card.innerHTML = `
                    <div class="student-card-header">
                        <div>
                            <h2>
                                ${student.name}
                            </h2>
                            <p>
                                ${student.speciality}
                            </p>
                        </div>
                    </div>
                    <div class="student-info">
                        <div class="info-item">
                            <span>
                                Телефон: 
                            </span>
                            <strong>
                                ${student.phone}
                            </strong>
                        </div>
                        <div class="info-item">
                            <span>
                                Email: 
                            </span>
                            <strong>
                                ${student.email}
                            </strong>
                        </div>
                        <div class="info-item">
                            <span>
                                Курс: 
                            </span>
                            <strong>
                                ${student.course}
                            </strong>
                        </div>
                        <div class="info-item">
                            <span>
                                Дата рождения: 
                            </span>
                            <strong>
                                ${student.birthDate}
                            </strong>
                        </div>
                        <div class="info-item">
                            <span>
                                Технологии: 
                            </span>
                            <strong>
                                ${student.technologies.join(", ")}
                            </strong>
                        </div>
                        <div class="info-item">
                            <span>
                                Город: 
                            </span>
                            <strong>
                                ${student.city}
                            </strong>
                        </div>
                        <div class="info-item">
                            <span>
                                Форма обучения: 
                            </span>
                            <strong>
                                ${student.modeOfStudy}
                            </strong>
                        </div>
                        <div class="info-item">
                            <span>
                                Основной язык: 
                            </span>
                            <strong>
                                ${student.mainLanguage}
                            </strong>
                        </div>
                        <div class="info-item">
                            <span>
                                О себе: 
                            </span>
                            <strong>
                                ${student.story}
                            </strong>
                        </div>
                    </div>
                    <button 
                        class="delete-button" 
                        onclick="deleteStudent(${student.id})">
                        Удалить
                    </button>
                    `;

                    studentsList.appendChild(card);
                
            });
        } catch(error) {
            console.error(error);
            studentsList.innerHTML = `
            <div class="result">
                Не удалось загрузить список студентов
            </div>
            `;
        }
    }

    @* Удаление анкеты студентов *@
    async function deleteStudent(id) {
        try {
            const token = document.querySelector(
                'input[name="__RequestVerificationToken"]'
                ).value;
            const response = await fetch("?handler=Delete&id=" + id, {
                method: "POST",
                headers: {
                    "RequestVerificationToken": token
                }

            });

            if(!response.ok) {
                throw new Error("Ошибка удаления");
            }

            const result = await response.json();
            
            if(result.success) {
                status.textContent = "Анкета студента удалена";
                await loadStudents();
            }

        } catch(error) {
            console.error(error);
            status.textContent = "Не удалось удалить анкету студента";
        }
    }
    @* ОЧИСТКА ФОРМЫ *@
    form.addEventListener("reset", function () {
        document.querySelector('#result').style.display = 'none';
        document.querySelector('#status').textContent = '';
    })
    @* ЗАГРУЗКА СПИСКА ПРИ ОТКРЫТИИ *@
        loadStudents();

</script>